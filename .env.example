# ---- Como o Jeremias decide quem responde ----
# auto  = (padrão) 1) ferramentas locais sem IA (hora, contas, arquivos, validação)
#                  2) modelo local (Ollama) para conversa geral
#                  3) nuvem (Gemini) SÓ para pesquisa na internet ou se não houver modelo local,
#                     e sempre depois de você clicar em "Enviar à nuvem"
# local = nunca usa a nuvem
# cloud = vai direto ao Gemini, sem confirmar (ferramentas locais ainda rodam primeiro)
LLM_MODE=auto

# Pastas onde a busca de arquivos e o hash são permitidos (separe por ; no Windows, : no Linux/Mac).
# Sem isto, valem Documentos, Downloads e Área de Trabalho do seu usuário.
# JEREMIAS_FILE_ROOTS=C:\Users\SeuNome\Documents;D:\Estudos

# Gemini: chave em https://aistudio.google.com/apikey  (NUNCA commite o valor real)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Modelo reserva, usado só se o principal seguir com erro 503 (alta demanda). Vazio = desligado.
# Deixe vazio se não souber qual modelo a sua chave aceita.
GEMINI_FALLBACK_MODEL=
# auto = o servidor escolhe por pergunta | low | medium | high
GEMINI_THINKING_LEVEL=auto

# Ollama (modelo local): instale em https://ollama.com e rode `ollama pull llama3.2:3b`
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL= qwen3.5:4b

# Pasta onde o Jeremias CRIA arquivos (só ela). Padrão: Documentos\Jeremias
# JEREMIAS_WORK_DIR=C:\Users\SeuNome\Documents\Jeremias
# Tipos extras que ele pode criar além de txt, md, csv, json, html, css, xml, yaml, log (scripts ficam de fora por padrão)
# JEREMIAS_EXTRA_EXTS=py,ts

# ---- Servidor ----
PORT=3000
# Só esta máquina acessa. O servidor executa comandos: NÃO use 0.0.0.0 nem ngrok.
HOST=127.0.0.1

# ---- Ledger e sandbox ----
# LEDGER_FILE=data/audit.jsonl
# Imagem usada no sandbox (precisa estar baixada: docker pull alpine:3)
SANDBOX_IMAGE=alpine:3
# SANDBOX_SECCOMP_PROFILE=caminho/para/perfil.json   (sem isso vale o perfil padrão do Docker)
